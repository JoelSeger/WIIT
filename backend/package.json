{
  "name": "backend",
  "version": "1.0.0",
  "description": "WIIT",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node --import tsx node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.ts",
    "migrate:make": "node --import tsx node_modules/knex/bin/cli.js migrate:make --knexfile knexfile.ts",
    "migrate:rollback": "node --import tsx node_modules/knex/bin/cli.js migrate:rollback --knexfile knexfile.ts",
    "migrate:status": "node --import tsx node_modules/knex/bin/cli.js migrate:status --knexfile knexfile.ts",
    "seed": "node --import tsx node_modules/knex/bin/cli.js seed:run --knexfile knexfile.ts",
    "seed:make": "node --import tsx node_modules/knex/bin/cli.js seed:make --knexfile knexfile.ts",
    "test": "jest",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:legacy": "tsx test/ead-export.test.ts && tsx test/ead-import.test.ts && tsx test/search.test.ts",
    "report:summarize": "tsx scripts/test_report.ts"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.11.2",
    "knex": "^3.3.0",
    "knex-stringcase": "^1.6.0",
    "mssql": "^12.7.9",
    "multer": "^2.4.0",
    "tedious": "^20.3.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "better-sqlite3": "^13.0.3",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true,
    "@swc/core@1.16.22": true,
    "@parcel/watcher@2.6.0": true
  },
  "jest-junit": {
    "outputDirectory": "src/unit_tests/reports",
    "outputName": "junit.xml"
  }
}
