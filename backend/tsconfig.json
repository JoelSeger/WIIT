{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false
  },

  "rootDir": ".",
  "include": ["src/**/*.ts", "src/types/.d.ts", "knexfile.ts", "src/routers/userRouter"],
  "exclude": ["node_modules", "dist"]
}
